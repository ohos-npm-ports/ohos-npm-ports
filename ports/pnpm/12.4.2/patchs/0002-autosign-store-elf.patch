+/// OHOS: the kernel refuses to exec/dlopen an ELF without a `.codesign`
+/// section, so package-shipped binaries are signed as they enter the
+/// store and every node_modules link mode propagates signed bytes.
+/// Idempotent; a signing error leaves the file unsigned (non-fatal, the
+/// same policy as uv's OHOS wheel signing). No-op off OHOS.
+fn ohos_sign_if_needed(bytes: &[u8]) -> Cow<'_, [u8]> {
+    #[cfg(target_env = "ohos")]
+    if is_unsigned_elf(bytes) {
+        match ohos_sign::sign_elf(bytes, false) {
+            Ok(signed) => {
+                ohos_sign_debug(|| format!("signed in-memory ELF ({} -> {} bytes)", bytes.len(), signed.len()));
+                return Cow::Owned(signed);
+            }
+            Err(error) => ohos_sign_debug(|| format!("sign failed, leaving unsigned: {error}")),
+        }
+    }
+    Cow::Borrowed(bytes)
+}
+
+#[cfg(target_env = "ohos")]
+fn is_unsigned_elf(bytes: &[u8]) -> bool {
+    bytes.len() >= 64 && bytes[..4] == *b"\x7fELF" && !ohos_sign::has_codesign_section(bytes)
+}
+
+#[cfg(target_env = "ohos")]
+fn ohos_sign_debug(message: impl Fn() -> String) {
+    if std::env::var_os("OHOS_SIGN_DEBUG").is_some() {
+        eprintln!("[pnpm-ohos-sign] {}", message());
+    }
+}
+
+/// Reader-path counterpart of [`ohos_sign_if_needed`]: the streamed bytes
+/// are already in `tmp_path`, so sign in place and re-hash — the CAS
+/// address and the returned size must describe the signed content.
+#[cfg(target_env = "ohos")]
+fn ohos_sign_temp_and_rehash(tmp_path: &Path, hash: FileHash, size: u64) -> (FileHash, u64) {
+    let Ok(bytes) = fs::read(tmp_path) else { return (hash, size) };
+    if !is_unsigned_elf(&bytes) {
+        return (hash, size);
+    }
+    match ohos_sign::sign_elf(&bytes, false) {
+        Ok(signed) if fs::write(tmp_path, &signed).is_ok() => {
+            ohos_sign_debug(|| format!("{}: signed ({} -> {} bytes)", tmp_path.display(), bytes.len(), signed.len()));
+            (Sha512::digest(&signed), signed.len() as u64)
+        }
+        Ok(_) => (hash, size),
+        Err(error) => {
+            ohos_sign_debug(|| format!("{}: sign failed, leaving unsigned: {error}", tmp_path.display()));
+            (hash, size)
+        }
+    }
+}
