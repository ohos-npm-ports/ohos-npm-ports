+// Older system images ship a libtime_service_ndk.so without
+// OH_TimeService_GetTimeZone, and a load-time link against it refuses to
+// start the process there. Resolve the symbol at runtime instead so the
+// fallback (UTC) applies when the API is absent.
+fn get_timezone_fn() -> Option<GetTimeZoneFn> {
+    const RTLD_NOW: c_int = 2;
+    const LIB: &[u8] = b"libtime_service_ndk.so\0";
+    const SYMBOL: &[u8] = b"OH_TimeService_GetTimeZone\0";
+    unsafe {
+        let lib = dlopen(LIB.as_ptr().cast(), RTLD_NOW);
+        if lib.is_null() {
+            return None;
+        }
+        let symbol = dlsym(lib, SYMBOL.as_ptr().cast());
+        if symbol.is_null() {
+            return None;
+        }
+        Some(core::mem::transmute::<*mut c_void, GetTimeZoneFn>(symbol))
+    }
 }
 
