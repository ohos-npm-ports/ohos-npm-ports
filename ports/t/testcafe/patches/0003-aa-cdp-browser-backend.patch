+import log from './log.cjs';
+import { execFile } from 'node:child_process';
+import { promisify } from 'node:util';
+import net from 'node:net';
+import { readFileSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+const statePath=join(tmpdir(),'testcafe-haitai-endpoint.json');
+function readState(){try{return JSON.parse(readFileSync(statePath,'utf8'));}catch{return null;}}
+function writeState(state){writeFileSync(statePath,JSON.stringify(state));}
+async function tryProbe(url){try{const r=await fetch(url,{signal:AbortSignal.timeout(500)});if(!r.ok)return null;return await r.json();}catch{return null;}}
+function validatePort(port){if(!Number.isInteger(port)||port<1||port>65535)throw new Error('Invalid CDP port');}
+function assertHaitai(version,port){
+    if(!version.Browser || !version.webSocketDebuggerUrl)throw new Error('Endpoint is not a CDP browser');
+    const ws=new URL(version.webSocketDebuggerUrl);
+    if(!/htbrowser\//i.test(version['User-Agent']||'') || ws.hostname!=='127.0.0.1' || Number(ws.port)!==port)throw new Error('CDP endpoint is not Haitai on the expected loopback port');
+}
+const execAsync = promisify(execFile);
+async function freePort() {
+    const server = net.createServer();
+    await new Promise((resolve,reject)=>{server.once('error',reject);server.listen(0,'127.0.0.1',resolve);});
+    const port=server.address().port;
+    await new Promise((resolve,reject)=>server.close(error=>error?reject(error):resolve()));
+    return port;
+}
+async function waitForCdp(url) {
+    const deadline=Date.now()+30000;
+    let lastError;
+    while(Date.now()<deadline) {
+        try {
+            const response=await fetch(url,{signal:AbortSignal.timeout(1000)});
+            if(!response.ok) throw new Error(`HTTP ${response.status}`);
+            return await response.json();
+        } catch(error) {lastError=error;await new Promise(resolve=>setTimeout(resolve,200));}
+    }
+    throw new Error(`CDP endpoint unavailable: ${url}; ${lastError?.message}. Close an existing Haitai instance manually before retrying.`);
+}
+export async function launchHaitai({port,exec=execAsync,probe=waitForCdp,readState:read=readState,writeState:write=writeState,tryProbe:quick=tryProbe}={}) {
+    if(port!==undefined)validatePort(port);
+    const cached=port===undefined?read():null;
+    const candidate=port ?? cached?.port;
+    if(candidate!==undefined && Number.isInteger(candidate) && candidate>0 && candidate<=65535){
+        const version=await quick(`http://127.0.0.1:${candidate}/json/version`);
+        if(version){
+            assertHaitai(version,candidate);
+            write({port:candidate});
+            log('AA_REUSE_CDP',`http://127.0.0.1:${candidate}`);
+            return `http://127.0.0.1:${candidate}`;
+        }
+    }
+    port ??= await freePort();
+    const args=['start','-b','com.haitai.htbrowser','-a','EntryAbility','--ps','cmdArgs',`--no-first-run --enable-automation --disable-popup-blocking --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows --disable-extensions --disable-sync --no-default-browser-check --remote-debugging-port=${port}`];
+    let result;
+    try {result=await exec('/usr/bin/aa',args,{timeout:5000});}
+    catch(error) {
+        if(error.code!=='ENOEXEC') throw error;
+        result=await exec('sh',['/usr/bin/aa',...args],{timeout:5000});
+    }
+    log('AA_START',result.stdout?.trim());
+    if(!result.stdout?.includes('start ability successfully')) throw new Error(`aa start failed: ${result.stdout || result.stderr}`);
+    const endpoint=`http://127.0.0.1:${port}`;
+    const version=await probe(`${endpoint}/json/version`);
+    assertHaitai(version,port);
+    write({port});
+    log('AA_DIRECT_CDP',endpoint);
+    return endpoint;
+}
