+const log=require('./log.cjs');
+const CDPDefault=require('chrome-remote-interface');
+const {PNG}=require('pngjs');
+const {writeFile,mkdir}=require('node:fs/promises');
+const path=require('node:path');
+const {createWindowController}=require('./window-controller.cjs');
+const {installDownloads}=require('./download.cjs');
+function createProvider(dependencies={}) {
+    const sessions=new Map();
+    const CDP=dependencies.CDP||CDPDefault;
+    async function activeClient(session){
+        if(!session.activeWindowId || session.activeWindowId===session.rootWindowId)return session.client;
+        for(let attempt=0;attempt<30;attempt++){
+            const {targetInfos}=await session.browser.Target.getTargets();
+            const target=targetInfos.find(info=>info.browserContextId===session.contextId && info.type==='page' && info.title.includes(session.activeWindowId));
+            if(target){
+                if(!session.clients.has(target.targetId)){
+                    const client=await CDP({...session.options,target:target.targetId});
+                    await client.Page.enable();
+                    if(process.env.TESTCAFE_DOWNLOAD_DIR)session.downloadStops.push(await (dependencies.downloads||installDownloads)(client,path.resolve(process.env.TESTCAFE_DOWNLOAD_DIR)));
+                    client.ohosTargetId=target.targetId;session.clients.set(target.targetId,client);
+                }
+                return session.clients.get(target.targetId);
+            }
+            await new Promise(resolve=>setTimeout(resolve,100));
+        }
+        throw new Error(`Cannot resolve owned window ${session.activeWindowId}`);
+    }
+    async function activeWindow(session){
+        const client=await activeClient(session),target=client.ohosTargetId;
+        if(!session.windows.has(target))session.windows.set(target,createWindowController({browser:session.browser,target,readViewport:async()=>{
+            const response=await client.Runtime.evaluate({expression:'({width:innerWidth,height:innerHeight,availWidth:screen.availWidth,availHeight:screen.availHeight})',returnByValue:true});return response.result.value;
+        }}));
+        return session.windows.get(target);
+    }
+    return {
+        supportMultipleWindows:true,
+        getActiveWindowId(id){return sessions.get(id)?.activeWindowId;},
+        setActiveWindowId(id,value){sessions.get(id).activeWindowId=value;log('ACTIVE_WINDOW',id,value);},
+        resetActiveWindowId(id){if(sessions.has(id))sessions.get(id).activeWindowId=undefined;},
+        getNewActiveWindowId(){return this.calculateWindowId();},
+        async closeBrowserChildWindow(){},
+        async isValidBrowserName(name){return name===''||name==='default';},
+        async hasCustomActionForBrowser(){return {hasCloseBrowser:true,hasTakeScreenshot:true,hasChromelessScreenshots:true,hasResizeWindow:true,hasMaximizeWindow:true,hasCanResizeWindowToDimensions:true};},
+        async canResizeWindowToDimensions(id,width,height){return (await activeWindow(sessions.get(id))).canResize(width,height);},
+        async resizeWindow(id,width,height){await (await activeWindow(sessions.get(id))).resize(width,height);},
+        async maximizeWindow(id){await (await activeWindow(sessions.get(id))).maximize();},
+        async openBrowser(id,pageUrl){
+            const launch=dependencies.launch||(await import('./aa-launcher.mjs')).launchHaitai;
+            const {ensureForeground,keepForeground}=await import('./foreground.mjs');
+            const endpoint=new URL(await launch({port:process.env.HARMONY_DEBUG_PORT?Number(process.env.HARMONY_DEBUG_PORT):undefined}));
+            const options={host:endpoint.hostname,port:Number(endpoint.port)};
+            const browser=await CDP({...options,target:(await CDP.Version(options)).webSocketDebuggerUrl});
+            let target,contextId;
+            try{
+                contextId=(await browser.Target.createBrowserContext()).browserContextId;
+                if(process.env.TESTCAFE_DOWNLOAD_DIR){
+                    await mkdir(path.resolve(process.env.TESTCAFE_DOWNLOAD_DIR),{recursive:true});
+                    await browser.Browser.setDownloadBehavior({behavior:'deny',downloadPath:path.resolve(process.env.TESTCAFE_DOWNLOAD_DIR),browserContextId:contextId,eventsEnabled:true});
+                }
+                target=(await browser.Target.createTarget({url:'about:blank',browserContextId:contextId})).targetId;
+            }catch(error){if(contextId)await browser.Target.disposeBrowserContext({browserContextId:contextId});await browser.close();throw error;}
+            const session={target,options,browser,contextId,clients:new Map(),windows:new Map(),downloadStops:[]};
+            sessions.set(id,session);
+            try{
+                session.client=await CDP({...options,target});
+                if(process.env.TESTCAFE_DOWNLOAD_DIR)session.downloadStops.push(await (dependencies.downloads||installDownloads)(session.client,path.resolve(process.env.TESTCAFE_DOWNLOAD_DIR)));
+                session.client.ohosTargetId=target;
+                session.clients.set(target,session.client);
+                await session.client.Page.enable();
+                await session.client.Page.navigate({url:pageUrl});
+                const guard={
+                    Page:{bringToFront:async()=> (await activeClient(session)).Page.bringToFront()},
+                    Runtime:{evaluate:async options=>(await activeClient(session)).Runtime.evaluate(options)},
+                };
+                session.stop=(dependencies.keepForeground||keepForeground)(guard);
+                await this.waitForConnectionReady(id);
+                await (dependencies.foreground||ensureForeground)(session.client);
+                session.activeWindowId=this.calculateWindowId?.() || require('node:crypto').randomBytes(8).toString('hex');
+                session.rootWindowId=session.activeWindowId;
+                log('PROVIDER_READY',id);
+            }catch(error){await this.closeBrowser(id);throw error;}
+        },
+        async closeBrowser(id){
+            const session=sessions.get(id);
+            if(!session)return;
+            sessions.delete(id);
+            await session.stop?.();
+            let restoreError;
+            try{for(const stop of session.downloadStops)await stop();}catch(error){restoreError=error;}
+            try{
+                if(session.windows.size){
+                    const {targetInfos}=await session.browser.Target.getTargets();
+                    for(const [target,controller] of session.windows)if(targetInfos.some(info=>info.targetId===target))await controller.restore();
+                }
+            }catch(error){restoreError=error;}
+            try{for(const client of session.clients.values())await client.close();}finally{try{await session.browser.Target.disposeBrowserContext({browserContextId:session.contextId});}finally{await session.browser.close();}}
+            log('PROVIDER_TARGET_CLOSED',id);
+            if(restoreError){console.error('PROVIDER_CLEANUP_ERROR',restoreError.message);throw restoreError;}
+        },
+        async takeScreenshot(id,filePath,pageWidth,pageHeight,fullPage){
+            const session=sessions.get(id);
+            if(!session)throw new Error('No active browser session');
+            const client=await activeClient(session);
+            const options={format:'png',fromSurface:true,captureBeyondViewport:!!fullPage};
+            if(fullPage){
+                const metrics=await client.Page.getLayoutMetrics();
+                const size=metrics.cssContentSize||metrics.contentSize;
+                options.clip={x:0,y:0,width:size.width,height:size.height,scale:1};
+            }
+            const {data}=await client.Page.captureScreenshot(options);
+            const bytes=Buffer.from(data||'','base64');
+            let image;
+            try{image=PNG.sync.read(bytes);}catch{throw new Error('CDP did not return a valid PNG');}
+            if(!image.width||!image.height)throw new Error('CDP returned an empty PNG');
+            await mkdir(path.dirname(filePath),{recursive:true});
+            await writeFile(filePath,bytes);
+            log('PROVIDER_SCREENSHOT',JSON.stringify({filePath,width:image.width,height:image.height,fullPage:!!fullPage}));
+        },
+        async dispose(){for(const id of sessions.keys())await this.closeBrowser(id);},
+    };
+}
+module.exports={createProvider};
