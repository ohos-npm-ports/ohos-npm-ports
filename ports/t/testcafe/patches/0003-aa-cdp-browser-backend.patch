@@ -0,0 +1,27 @@
+import log from './log.cjs';
+export async function ensureForeground(client,{timeoutMs=10000,intervalMs=200}={}) {
+    const deadline=Date.now()+timeoutMs;
+    let state;
+    do {
+        await client.Page.bringToFront();
+        const response=await client.Runtime.evaluate({expression:'({visibility:document.visibilityState,focus:document.hasFocus()})',returnByValue:true});
+        state=response.result.value;
+        if(state?.visibility==='visible' && state?.focus){log('FOREGROUND_CONFIRMED',JSON.stringify(state));return;}
+        await new Promise(resolve=>setTimeout(resolve,intervalMs));
+    }while(Date.now()<deadline);
+    throw new Error(`Test target is not foreground: ${JSON.stringify(state)}`);
+}
+export function keepForeground(client,{intervalMs=500}={}) {
+    let pending=null;
+    const timer=setInterval(()=>{
+        if(pending)return;
+        pending=(async()=>{
+            const response=await client.Runtime.evaluate({expression:'({visibility:document.visibilityState,focus:document.hasFocus()})',returnByValue:true});
+            if(response.result.value?.visibility!=='visible' || !response.result.value?.focus){
+                await client.Page.bringToFront();
+                log('FOREGROUND_REACTIVATED');
+            }
+        })().catch(error=>log('FOREGROUND_PROBE',error.message)).finally(()=>{pending=null;});
+    },intervalMs);
+    return async()=>{clearInterval(timer);await pending;};
+}
