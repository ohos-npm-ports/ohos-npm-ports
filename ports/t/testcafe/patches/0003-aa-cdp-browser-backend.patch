@@ -0,0 +1,64 @@
+const log=require('./log.cjs');
+const fs=require('node:fs/promises');
+const path=require('node:path');
+const {randomUUID}=require('node:crypto');
+function filename(disposition){
+    const encoded=/filename\*=UTF-8''([^;]+)/i.exec(disposition);
+    const plain=/filename=(?:"([^"]*)"|([^;]+))/i.exec(disposition);
+    let name=plain?.[1]||plain?.[2]||'download.bin';
+    if(encoded){try{name=decodeURIComponent(encoded[1]);}catch{}}
+    name=path.basename(name.replace(/\\/g,'/')).replace(/[\x00-\x1f<>:"|?*]/g,'_').trim();
+    return !name||name==='.'||name==='..'?'download.bin':name.slice(0,180);
+}
+async function installDownloads(client,directory){
+    await fs.mkdir(directory,{recursive:true});
+    let queue=Promise.resolve();
+    const pending=new Set(),errors=[];
+    let stopping=false,closed=false;
+    const onDisconnect=()=>{closed=true;};
+    client.on?.('disconnect',onDisconnect);
+    async function capture(event,disposition){
+        const temporary=path.join(directory,`.download-${randomUUID()}.part`);
+        let stream,file;
+        try{
+            stream=(await client.Fetch.takeResponseBodyAsStream({requestId:event.requestId})).stream;
+            file=await fs.open(temporary,'wx');
+            let bytes=0;
+            while(true){
+                const chunk=await client.IO.read({handle:stream,size:65536});
+                const buffer=Buffer.from(chunk.data,chunk.base64Encoded?'base64':'utf8');
+                await file.writeFile(buffer);bytes+=buffer.length;
+                if(chunk.eof)break;
+            }
+            await file.close();file=null;
+            const name=filename(disposition),extension=path.extname(name),stem=name.slice(0,name.length-extension.length);
+            let destination=path.join(directory,name),index=0;
+            while(true){try{await fs.stat(destination);destination=path.join(directory,`${stem} (${++index})${extension}`);}catch(error){if(error.code==='ENOENT')break;throw error;}}
+            await client.Fetch.fulfillRequest({requestId:event.requestId,responseCode:204,responseHeaders:[],body:''});
+            await fs.rename(temporary,destination);
+            log('PROVIDER_DOWNLOAD',JSON.stringify({path:destination,bytes,resourceType:event.resourceType}));
+        }finally{
+            await file?.close();
+            if(stream)await client.IO.close({handle:stream}).catch(()=>{});
+            await fs.rm(temporary,{force:true});
+        }
+    }
+    client.Fetch.requestPaused(event=>{
+        const task=(async()=>{
+            const disposition=event.responseHeaders?.find(header=>header.name.toLowerCase()==='content-disposition')?.value||'';
+            if(stopping){await client.Fetch.continueRequest({requestId:event.requestId});return;}
+            if(!['Document','Other'].includes(event.resourceType)||!/^attachment\b/i.test(disposition)||event.responseStatusCode<200||event.responseStatusCode>=300){await client.Fetch.continueRequest({requestId:event.requestId});return;}
+            const previous=queue;
+            queue=previous.then(()=>capture(event,disposition));
+            await queue;
+        })().catch(async error=>{
+            if(stopping)return;
+            errors.push(error);console.error('PROVIDER_DOWNLOAD_ERROR',error.message);
+            await client.Fetch.failRequest({requestId:event.requestId,errorReason:'Aborted'}).catch(()=>{});
+        }).finally(()=>pending.delete(task));
+        pending.add(task);
+    });
+    await client.Fetch.enable({patterns:[{urlPattern:'*',requestStage:'Response'}]});
+    return async()=>{await Promise.all([...pending]);stopping=true;if(!closed)await client.Fetch.disable().catch(error=>{if(!closed)throw error;});await Promise.all([...pending]);client.removeListener?.('disconnect',onDisconnect);if(errors.length)throw errors[0];};
+}
+module.exports={installDownloads};
