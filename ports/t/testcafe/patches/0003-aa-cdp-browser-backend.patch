@@ -0,0 +1,17 @@
+const {PNG}=require('pngjs');
+const {readFile,writeFile,mkdir}=require('node:fs/promises');
+const path=require('node:path');
+async function generateThumbnail(sourcePath,thumbnailPath,width=240,height=130){
+    if(!Number.isInteger(width)||!Number.isInteger(height)||width<1||height<1)throw new Error('Invalid thumbnail dimensions');
+    const source=PNG.sync.read(await readFile(sourcePath));
+    const scale=Math.min(width/source.width,height/source.height);
+    const output=new PNG({width:Math.max(1,Math.round(source.width*scale)),height:Math.max(1,Math.round(source.height*scale))});
+    for(let y=0;y<output.height;y++)for(let x=0;x<output.width;x++){
+        const sourceX=Math.min(source.width-1,Math.floor(x*source.width/output.width));
+        const sourceY=Math.min(source.height-1,Math.floor(y*source.height/output.height));
+        source.data.copy(output.data,(y*output.width+x)*4,(sourceY*source.width+sourceX)*4,(sourceY*source.width+sourceX)*4+4);
+    }
+    await mkdir(path.dirname(thumbnailPath),{recursive:true});
+    await writeFile(thumbnailPath,PNG.sync.write(output));
+}
+module.exports={generateThumbnail};
