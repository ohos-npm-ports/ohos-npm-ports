@@ -0,0 +1,44 @@
+const log=require('./log.cjs');
+function createWindowController({browser,target,readViewport,pause=ms=>new Promise(resolve=>setTimeout(resolve,ms))}){
+    let initial,windowId,dirty=false;
+    async function initialize(){if(initial)return;const info=await browser.Browser.getWindowForTarget({targetId:target});windowId=info.windowId;initial={...info.bounds};}
+    async function bounds(){await initialize();return (await browser.Browser.getWindowBounds({windowId})).bounds;}
+    async function set(change){dirty=true;await browser.Browser.setWindowBounds({windowId,bounds:change});await pause(150);}
+    return {
+        async canResize(width,height){
+            if(!Number.isInteger(width)||!Number.isInteger(height)||width<1||height<1)return false;
+            const outer=await bounds(),viewport=await readViewport();
+            return width+Math.max(0,outer.width-viewport.width)<=viewport.availWidth && height+Math.max(0,outer.height-viewport.height)<=viewport.availHeight;
+        },
+        async resize(width,height){
+            if(!Number.isInteger(width)||!Number.isInteger(height)||width<1||height<1)throw new Error('Invalid window dimensions');
+            await initialize();
+            if((await bounds()).windowState!=='normal')await set({windowState:'normal'});
+            let last;
+            for(let attempt=0;attempt<5;attempt++){
+                const outer=await bounds(),viewport=await readViewport();
+                await set({width:Math.round(width+Math.max(0,outer.width-viewport.width)),height:Math.round(height+Math.max(0,outer.height-viewport.height))});
+                last=await readViewport();
+                if(last.width===width&&last.height===height){log('PROVIDER_RESIZE',JSON.stringify({width,height}));return;}
+            }
+            throw new Error(`Window did not reach ${width}x${height}: ${JSON.stringify(last)}`);
+        },
+        async maximize(){
+            await initialize();
+            await set({windowState:'maximized'});
+            for(let attempt=0;attempt<5;attempt++){if((await bounds()).windowState==='maximized'){log('PROVIDER_MAXIMIZE_OK');return;}await pause(150);}
+            throw new Error('Window is not maximized after CDP request');
+        },
+        async restore(){
+            if(!initial||!dirty)return;
+            await set({windowState:'normal'});
+            const {left,top,width,height,windowState}=initial;
+            await set({left,top,width,height});
+            if(windowState!=='normal')await set({windowState});
+            const actual=await bounds();
+            if(actual.windowState!==windowState || (windowState==='normal'&&['left','top','width','height'].some(key=>actual[key]!==initial[key])))throw new Error(`Failed to restore window bounds: ${JSON.stringify(actual)}`);
+            dirty=false;log('PROVIDER_WINDOW_RESTORED',JSON.stringify(actual));
+        },
+    };
+}
+module.exports={createWindowController};
