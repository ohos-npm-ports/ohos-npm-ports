--- a/crates/libghostty-vt-sys/build.rs
+++ b/crates/libghostty-vt-sys/build.rs
@@ -191,7 +191,10 @@
         build.arg(format!(
             "-Dtarget={architecture}-macos.{deployment_target}-none"
         ));
-    } else if target.contains("windows") || target != host {
+    } else if target.contains("windows") || target.contains("ohos") || target != host {
+        // OHOS port: always pass -Dtarget, even for "native" builds — zig's
+        // native auto-detect on OHOS mixes its bundled headers with the ohos-sdk
+        // sysroot via include_next and dies on missing bits/alltypes.h.
         // Rust's HOST describes rustc, which may differ from the Zig compiler
         // architecture when Windows runs a compiler under emulation.
         build.arg(format!("-Dtarget={}", zig_target(&target)));
@@ -582,6 +585,10 @@
         "aarch64-pc-windows-msvc" => "aarch64-windows-msvc",
         "aarch64-linux-android" => "aarch64-linux-android",
         "x86_64-linux-android" => "x86_64-linux-android",
+        // OHOS port: ghostty's build.zig has no ohos target; route onto musl
+        // (same libc/ABI) — the static lib is linked by rustc's linker anyway.
+        "aarch64-unknown-linux-ohos" => "aarch64-linux-musl",
+        "x86_64-unknown-linux-ohos" => "x86_64-linux-musl",
         other => panic!("unsupported Rust target for vendored build: {other}"),
     };
     value.to_owned()
