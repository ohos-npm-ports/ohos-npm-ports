#!/usr/bin/env bash
pkgname="turbo"
upstream="turbo"
version="2.11.10"
revision=1
dist_tag="latest"

packages=(
  "build/turbo-${version}"
)
ghostty_commit=5147c0a503cdeed7615cce245cdd815ed7a6b692
rust_nightly=2026-07-03
source="https://codeload.github.com/vercel/turborepo/tar.gz/refs/tags/v${version}"
sha256="a9786d3236e75aa32aac690018e6282952f9ef252f541274798c181dc1550b64"
resource "zig" \
  "https://ziglang.org/download/0.17.0/zig-aarch64-linux-0.17.0.tar.xz" \
  "9e8d11661d4ae3bd57702a3832781e23ad151dde5798e16a5ccd503f65234ff8"
resource "rust_nightly" \
  "https://static.rust-lang.org/dist/${rust_nightly}/rust-nightly-aarch64-unknown-linux-ohos.tar.gz" \
  "3191de904f37ab70d64fe7b125b7d0f77ed5f6570ca409582f6966d1672174d9"
resource "ghostty" \
  "https://codeload.github.com/ghostty-org/ghostty/tar.gz/${ghostty_commit}" \
  "71c5b5d2ad2a2351dba79725c428a3065b51addc533ca8ec88114f1a9cfa7b10"

build() {
  # Source build of turbo for OpenHarmony (no prebuilt binaries): the Rust CLI
  # (crates/turborepo) and the TUI's libghostty-vt (via zig) compile natively on
  # an OHOS host; the JS launcher is the patched packages/turbo/bin/turbo.

  # Must match the pinned commit in crates/libghostty-vt-sys/build.rs.
  # Matches rust-toolchain.toml; the tree uses #![feature(...)] and -Z rustflags,
  # so stable rustc cannot build it.

  # Large downloads intermittently stall or die mid-transfer on some networks.

  # --- toolchain dependencies ---
  # protoc for turborepo-daemon's tonic-prost-build, capnp for the embedded
  # sccache, openssl@3/libxml2/zlib for rust-nightly's cargo and rust-lld.
  brew install -y protobuf capnp openssl@3 libxml2 zlib

  # zig for the TUI's libghostty-vt (ghostty's pinned commit requires
  # >= 0.17.0). Official static tarball; zig finds its lib/ via its own
  # realpath, so keep the extracted tree intact.
  cd "$NPMBUILD_WORK_DIR"
  zig_version=0.17.0
  zig_dir="zig-aarch64-linux-${zig_version}"
  extract_resource "zig" "$NPMBUILD_WORK_DIR/${zig_dir}"
  chmod +x "${zig_dir}/zig"
  export PATH="$(pwd)/${zig_dir}:$PATH"
  # Keep zig's cache inside the working directory: /data/storage/... only
  # exists on OHOS hosts, and $PWD works in both CI containers and devices.
  export ZIG_GLOBAL_CACHE_DIR="$(pwd)/zig-cache"

  # --- rust nightly toolchain (upstream-pinned channel) ---
  extract_resource "rust_nightly" "$NPMBUILD_WORK_DIR/rust-nightly-extract"
  rust_home="$NPMBUILD_WORK_DIR/rust-nightly"
  sh rust-nightly-extract/install.sh --prefix="${rust_home}" --disable-ldconfig \
    --components=rustc,cargo,rust-std-aarch64-unknown-linux-ohos
  rm -rf rust-nightly-extract

  export PATH="${rust_home}/bin:$PATH"
  export LD_LIBRARY_PATH="$(brew --prefix openssl@3)/lib:$(brew --prefix libxml2)/lib:$(brew --prefix zlib)/lib"
  # rust-nightly's cargo verifies TLS against the system OpenSSL trust store,
  # which is empty on OHOS; point it at harmonybrew's CA bundle.
  export CARGO_HTTP_CAINFO="$(brew --prefix)/etc/openssl@3/cert.pem"
  cargo --version

  # --- sources ---
  # Tarballs avoid a full git clone; cargo still resolves its own git dependencies.
  extract_source "$NPMBUILD_WORK_DIR/turborepo-${version}"

  # libghostty-vt-sys's build.rs git-clones ghostty at this pinned commit;
  # pre-seed via GHOSTTY_SOURCE_DIR.
  extract_resource "ghostty" "$NPMBUILD_WORK_DIR/ghostty-src"
  export ghostty_source_dir="$NPMBUILD_WORK_DIR/ghostty-src"

  cd "$NPMBUILD_WORK_DIR/turborepo-${version}"
  patch -p1 <"$NPMBUILD_DIR/patches/0002-openharmony-wrapper.patch"
  patch -p1 <"$NPMBUILD_DIR/patches/0005-libghostty-vt-sys-ohos-zig-target.patch"

  # Vendor the three crates that need OHOS fixes (same pattern bun-pty uses for
  # portable-pty), then wire up [patch.crates-io] + Cargo.lock via 0003/0004.
  cargo fetch
  mkdir -p vendor
  rm -rf vendor/nix vendor/zstd-sys vendor/aws-lc-sys
  # Machines with a configured cargo mirror have multiple registry src dirs.
  cp -r "$(ls -d "$HOME"/.cargo/registry/src/*/nix-0.26.2 | head -1)" vendor/nix
  cp -r "$(ls -d "$HOME"/.cargo/registry/src/*/zstd-sys-2.0.16+zstd.1.5.7 | head -1)" vendor/zstd-sys
  cp -r "$(ls -d "$HOME"/.cargo/registry/src/*/aws-lc-sys-0.46.0 | head -1)" vendor/aws-lc-sys
  chmod -R u+w vendor/nix vendor/zstd-sys vendor/aws-lc-sys
  (cd vendor/nix && patch -p1 <"$NPMBUILD_DIR/patches/0006-nix-0.26.2-ohos.patch")
  (cd vendor/zstd-sys && patch -p1 <"$NPMBUILD_DIR/patches/0007-zstd-sys-ohos-qsort.patch")
  (cd vendor/aws-lc-sys && patch -p1 <"$NPMBUILD_DIR/patches/0008-aws-lc-sys-ohos-cc-builder.patch")

  patch -p1 <"$NPMBUILD_DIR/patches/0003-workspace-cargo-manifest.patch"
  patch -p1 <"$NPMBUILD_DIR/patches/0004-cargo-lock.patch"

  # --- build ---
  cargo build --release --locked -p turbo
  test -f target/release/turbo

  # --- assemble the npm package ---
  # Mirror the published `turbo` package layout. schema.json is gitignored in
  # the repo (generated at release time); the turbo-types copy is
  # byte-identical to the published one.
  cd ..
  package_dir="${pkgname}-${version}"
  mkdir -p "${package_dir}/bin"
  cp "turborepo-${version}/packages/turbo/package.json" \
    "turborepo-${version}/packages/turbo/README.md" \
    "turborepo-${version}/LICENSE" \
    "${package_dir}/"
  cp "turborepo-${version}/packages/turbo/bin/turbo" "${package_dir}/bin/turbo"
  chmod +x "${package_dir}/bin/turbo"
  cp "turborepo-${version}/packages/turbo-types/schemas/schema.json" "${package_dir}/schema.json"

  llvm-strip --strip-all "turborepo-${version}/target/release/turbo" -o "${package_dir}/bin/turbo-linux-arm64"
  chmod +x "${package_dir}/bin/turbo-linux-arm64"

  cd "${package_dir}"

  # --- verify package contents ---

  # toybox patch can silently no-op on a malformed header, so confirm the
  # patches actually landed rather than trusting patch's exit code.
  grep -q 'turbo-linux-arm64' bin/turbo
  grep -q 'platform === "openharmony"' bin/turbo

}
