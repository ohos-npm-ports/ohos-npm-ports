#!/usr/bin/env bash
pkgname="tsrs"
upstream="tsrs"
version="0.25.0-ts7.1.0-beta"
revision=1
source="https://registry.npmjs.org/tsrs/-/tsrs-${version}.tgz"
sha256="c70acf9b4470ab4221fc070c544a7f83b64f1c6af7901fbdb65e45ac2a51cfe7"
resource "rust" \
  "https://static.rust-lang.org/dist/rust-1.99.1-aarch64-unknown-linux-ohos.tar.xz" \
  "4b078f77667e497d93f850c0f91ffbb39b764c3e51a2229db9de3f5b595385a3"
resource "source_tag" \
  "https://codeload.github.com/oxc-project/tsrs/tar.gz/refs/tags/v${version%%-*}" \
  "d139a9610e96f7ff33a9b74f5440f6eab9b8c4dd0ef9a7652734be74042309f7"
dist_tag="latest"

packages=(
  "@ohos-npm-ports/tsrs-openharmony-arm64:build/native"
  "build/main"
)

work_dir="$NPMBUILD_DIR"
build_dir="$NPMBUILD_WORK_DIR"
source_dir="$build_dir/tsrs-${version%%-*}"

prepare() {
  brew install -y cmake openssl@3 zlib-ng-compat libxml2
  if [ ! -x "$build_dir/rust/bin/rustc" ]; then
    extract_resource "rust" "$build_dir/rust-extract"
    sh "$build_dir/rust-extract/install.sh" \
      --prefix="$build_dir/rust" --disable-ldconfig \
      --components=rustc,cargo,rust-std-aarch64-unknown-linux-ohos
    rm -rf "$build_dir/rust-extract"
  fi
  export PATH="$build_dir/rust/bin:$PATH"
  export LD_LIBRARY_PATH="$(brew --prefix openssl@3)/lib:$(brew --prefix zlib-ng-compat)/lib:$(brew --prefix libxml2)/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  export CARGO_HTTP_CAINFO="$(brew --prefix)/etc/openssl@3/cert.pem"
  rustc --version

  fetch_source "$build_dir/npm.tgz"
  if [ ! -d "${source_dir}" ]; then
    extract_resource "source_tag" "${source_dir}"
  fi
}

build() {
  (cd "${source_dir}" && cargo test --locked -p tsrs_core --features plain-ptrs --lib)
  # HarmonyOS cannot reserve the default compressed-pointer arena address.
  (cd "${source_dir}" && cargo build --release --locked -p tsrs_cli --features noembed,tsrs_core/plain-ptrs)
}

package() {
  rm -rf "$build_dir/main" "$build_dir/native"
  mkdir -p "$build_dir/main" "$build_dir/native"
  tar -xzf "$build_dir/npm.tgz" -C "$build_dir/main" --strip-components=1
  cp "${source_dir}/target/release/tsrs" "$build_dir/native/tsrs"
  cp "${source_dir}/crates/tsrs_vfs/libs/"*.d.ts "$build_dir/native/"
  cp "${source_dir}/LICENSE" "${source_dir}/NOTICE" "$build_dir/native/"
  chmod +x "$build_dir/native/tsrs"
  manifest_set_dependency optionalDependencies "$build_dir/main/package.json" '@tsrs/openharmony-arm64' "npm:@ohos-npm-ports/tsrs-openharmony-arm64@${version}"
  build_dir="$build_dir" version="$version" node --input-type=module <<'JS'
import fs from 'node:fs';
const {build_dir: root, version} = process.env;
const pkg = JSON.parse(fs.readFileSync(`${root}/main/package.json`));
fs.writeFileSync(`${root}/native/package.json`, JSON.stringify({
 version,
 license:pkg.license, os:['openharmony'], cpu:['arm64'],
 exports:{'./package.json':'./package.json'}, files:['tsrs','*.d.ts','LICENSE','NOTICE'],
},null,2)+'\n');
JS
  build_dir="$build_dir" node --input-type=module <<'JS'
import fs from 'node:fs';
import assert from 'node:assert/strict';
import {execFileSync} from 'node:child_process';
const root=process.env.build_dir;
fs.mkdirSync(`${root}/original`, {recursive:true});
execFileSync('tar',['-xzf',`${root}/npm.tgz`,'-C',`${root}/original`,'--strip-components=1']);
function walk(dir, prefix='') {
 for (const e of fs.readdirSync(dir,{withFileTypes:true})) {
  const name=prefix+e.name;
  if(e.isDirectory()) walk(`${dir}/${e.name}`,name+'/');
  else if(name!=='package.json') assert.deepEqual(fs.readFileSync(`${dir}/${e.name}`),fs.readFileSync(`${root}/main/${name}`),name);
 }
}
walk(`${root}/original`);
const old=JSON.parse(fs.readFileSync(`${root}/original/package.json`));
const pkg=JSON.parse(fs.readFileSync(`${root}/main/package.json`));
for(const [name,v] of Object.entries(old.optionalDependencies)) assert.equal(pkg.optionalDependencies[name],v);
for(const k of ['name','version','repository','optionalDependencies']) {delete old[k];delete pkg[k];}
assert.deepEqual(pkg,old);
JS
}
