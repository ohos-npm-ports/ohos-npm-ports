 }
 
+// hongMengKernel reports whether the running kernel is HongMeng
+// (HarmonyOS). Detection uses uname(2): on HarmonyOS devices the sysname
+// is "HarmonyOS" and the release string starts with "HongMeng Kernel".
+func hongMengKernel() bool {
+	var uts unix.Utsname
+	if err := unix.Uname(&uts); err != nil {
+		return false
+	}
+	return utsFieldContains(uts.Sysname[:], "HongMeng") ||
+		utsFieldContains(uts.Release[:], "HongMeng") ||
+		utsFieldContains(uts.Sysname[:], "HarmonyOS")
+}
+
+// utsFieldContains reports whether the NUL-terminated field of
+// unix.Utsname contains sub.
+func utsFieldContains(field []byte, sub string) bool {
+	s := string(field)
+	if i := strings.IndexByte(s, 0); i >= 0 {
+		s = s[:i]
+	}
+	return strings.Contains(s, sub)
+}
