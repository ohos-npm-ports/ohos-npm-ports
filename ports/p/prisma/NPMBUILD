#!/usr/bin/env bash
pkgname="prisma"
upstream="prisma"
version="8.0.0-rc.33"
revision=1
dist_tag="latest"
composer_version="0.38.0"

packages=(
  "@ohos-npm-ports/prisma-composer:build/composer"
  "@ohos-npm-ports/prisma-composer-cli:build/composer-cli"
  "build/pkg"
)
work_dir="$NPMBUILD_DIR"
build_dir="$NPMBUILD_WORK_DIR"
source="https://registry.npmjs.org/${pkgname}/-/${pkgname}-${version}.tgz"
sha256="355a35f560c27a9ebfa8fbf9cf66f2382877b5aafa5c014b172f311a9f1983f2"
resource "composer" \
  "https://registry.npmjs.org/@prisma/composer/-/composer-${composer_version}.tgz" \
  "6b4a068ba7680515cc08eb977c18cb847198f9cc2021ca56442ff6e3b5df389a"
resource "composer_cli" \
  "https://registry.npmjs.org/@prisma/composer-cli/-/composer-cli-${composer_version}.tgz" \
  "a47cb2f3ad92d3e52dec00fb515ea839904ff9cf6ca251cfc560d30ea9eeb662"

prepare() {
  # ============================================================
  # ohos-npm-ports: @ohos-npm-ports/prisma ${version}
  #
  # 构建方式：
  #   1. 下载官方 prisma@${version} tarball，打 patch 改写 manifest
  #   2. 零编译重打包：上游全部内容（patch 过的 manifest 在内）进发布目录
  #   3. npm pack 成 tarball 后做 drop-in 冒烟（node + bun 双运行时）
  #
  # Prisma 8 no longer ships the Rust engine resolver that prisma 5 bundled:
  # the CLI is a pure-JavaScript shell around @prisma/cli-engine,
  # @prisma/orm-toolchain and @prisma/composer-cli, and no code downloads
  # engines from binaries.prisma.sh. The old OpenHarmony local-engines patch
  # is therefore obsolete and is not carried into this recipe.
  #
  # The main package must resolve both Composer packages from @ohos-npm-ports.
  # Repack them with alchemy 2.0.0-beta.84, which does not pull
  # @libsql/client -> libsql; libsql's npm metadata has no openharmony target,
  # so a plain consumer install would otherwise abort before the CLI is usable.
  # ============================================================

  # ===== fetch =====
  echo "=== fetch: 官方 prisma@${version} + Composer ${composer_version} ==="
  rm -rf "${build_dir}"
  mkdir -p "${build_dir}"
  cd "${build_dir}"
  extract_source "${build_dir}/src"
  extract_resource "composer" "${build_dir}/composer-src"
  extract_resource "composer_cli" "${build_dir}/composer-cli-src"
}

build() {
  echo "=== build: 校验 manifest 与入口 ==="
  cd "${build_dir}/src"
  patch -p1 <"${work_dir}/patches/0002-update-package-json.patch"
  grep -qF "\"@prisma/composer-cli\": \"npm:@ohos-npm-ports/prisma-composer-cli@${version}\"," package.json

  # Prisma 8 removed the bundled engine resolver; guard the premise of this
  # port so a future upstream change cannot silently restore the old download
  # path without a matching OpenHarmony patch.
  if grep -Rq 'binaries.prisma.sh\|getBinaryPathsByVersion' dist; then
    echo "prisma ${version} reintroduced an engine download path; add an OpenHarmony patch" >&2
    exit 1
  fi

  node -e '
      const p = require("./package.json");
      if (p.type !== "module" || p.bin?.prisma !== "./dist/prisma.js") {
        console.error("unexpected prisma 8 package layout");
        process.exit(1);
      }
      console.log("OK: prisma 8 ESM bin layout");
    '
  node --check dist/prisma.js
  node --check dist/config.js

  # Repack Composer against alchemy 2.0.0-beta.84 so the consumer install does
  # not pull libsql, whose npm platform metadata rejects openharmony. The
  # upstream API stays the same; only the dependency pin changes.
  (
    cd "${build_dir}/composer-src"
    COMPOSER_VERSION="${composer_version}" node -e '
        const fs = require("fs");
        const p = JSON.parse(fs.readFileSync("package.json", "utf8"));
        if (p.name !== "@prisma/composer" || p.version !== process.env.COMPOSER_VERSION) {
          console.error("unexpected @prisma/composer package layout");
          process.exit(1);
        }
        p.version = process.argv[1];
        p.dependencies.alchemy = "2.0.0-beta.84";
        delete p.devDependencies;
        fs.writeFileSync("package.json", JSON.stringify(p, null, 2) + "\n");
        console.log("OK: @prisma/composer repacked without libsql");
      ' "${version}"
  )
  (
    cd "${build_dir}/composer-cli-src"
    COMPOSER_CLI_VERSION="${composer_version}" node -e '
        const fs = require("fs");
        const p = JSON.parse(fs.readFileSync("package.json", "utf8"));
        if (p.name !== "@prisma/composer-cli" || p.version !== process.env.COMPOSER_CLI_VERSION) {
          console.error("unexpected @prisma/composer-cli package layout");
          process.exit(1);
        }
        p.version = process.argv[1];
        p.dependencies["@prisma/composer"] = `npm:@ohos-npm-ports/prisma-composer@${process.argv[1]}`;
        p.dependencies.alchemy = "2.0.0-beta.84";
        delete p.devDependencies;
        fs.writeFileSync("package.json", JSON.stringify(p, null, 2) + "\n");
        console.log("OK: @prisma/composer-cli repacked without libsql");
      ' "${version}"
  )
  test -f "${build_dir}/composer-src/dist/index.mjs"
  test -f "${build_dir}/composer-cli-src/dist/family.mjs"
  node --check "${build_dir}/composer-src/dist/index.mjs"
  node --check "${build_dir}/composer-cli-src/dist/family.mjs"
}

package() {
  echo "=== package: 组装发布目录 + manifest 断言 + npm pack ==="
  rm -rf "${build_dir}/pkg" "${build_dir}/composer" "${build_dir}/composer-cli"
  mkdir "${build_dir}/pkg" "${build_dir}/composer" "${build_dir}/composer-cli"
  # everything upstream ships, minus install-time state (the port manifests are
  # already rewritten in place by build)
  (cd "${build_dir}/src" && tar -zcf - . | tar -zxf - -C "${build_dir}/pkg")
  (cd "${build_dir}/composer-src" && tar -zcf - . | tar -zxf - -C "${build_dir}/composer")
  (cd "${build_dir}/composer-cli-src" && tar -zcf - . | tar -zxf - -C "${build_dir}/composer-cli")
  rm -rf "${build_dir}/pkg/node_modules" "${build_dir}/composer/node_modules" "${build_dir}/composer-cli/node_modules"
}
