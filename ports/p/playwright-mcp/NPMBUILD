#!/usr/bin/env bash
pkgname="playwright-mcp"
upstream="@playwright/mcp"
version="0.0.84"
revision=1
source="https://registry.npmjs.org/@playwright/mcp/-/mcp-${version}.tgz"
sha256="4e749bdc5a19138fed51cf0f51e43dca265c1bfc0fc388220fc70756aac60c26"
dist_tag="latest"

packages=(
  "build/playwright-mcp-${version}"
)
script_dir="$NPMBUILD_DIR"
root_dir="$NPMBUILD_WORK_DIR"

prepare() {
  cd "$root_dir"

  extract_source "$root_dir/${pkgname}-${version}"
  node -e 'const fs=require("fs"),crypto=require("crypto");const p=process.argv[1];const hashes=Object.fromEntries(fs.readdirSync(p).filter(f=>f!=="package.json").map(f=>[f,crypto.createHash("sha256").update(fs.readFileSync(p+"/"+f)).digest("hex")]));fs.writeFileSync("upstream-hashes.json",JSON.stringify(hashes))' "$root_dir/${pkgname}-${version}"
}

build() {
  cd "$root_dir/${pkgname}-${version}"
  patch -p1 <"$script_dir"/patches/0001-update-package-json.patch
}

package() {
  cd "$root_dir/${pkgname}-${version}"
  node -e 'const fs=require("fs"),crypto=require("crypto"),assert=require("assert/strict");for(const [f,hash] of Object.entries(JSON.parse(fs.readFileSync("../upstream-hashes.json"))))assert.equal(crypto.createHash("sha256").update(fs.readFileSync(f)).digest("hex"),hash,f)'

  node -e '
    const pkg = require("./package.json");
    if (pkg.dependencies["playwright-core"] !== "npm:@ohos-npm-ports/playwright-core@1.64.1-1")
      throw new Error(`playwright-core not aliased: ${pkg.dependencies["playwright-core"]}`);
    if ("playwright" in pkg.dependencies) throw new Error("unused playwright dep must be dropped");
    console.log("package.json rewrite OK");
  '

  node --check cli.js
  node --check index.js

  elf_files=$(find . -type f -exec sh -c 'od -An -tx1 -N4 "$1" | grep -q "7f 45 4c 46"' _ {} \; -print)
  [ -z "$elf_files" ] || {
    echo "unexpected ELF files in artifact:" $elf_files >&2
    exit 1
  }

}
