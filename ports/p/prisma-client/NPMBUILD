#!/usr/bin/env bash
pkgname="prisma-client"
upstream="@prisma/client"
version="7.10.1"
revision=1
dist_tag="latest"

packages=(
  "build/pkg"
)
work_dir="$NPMBUILD_DIR"
build_dir="${work_dir}/build"
source="https://registry.npmjs.org/@prisma/client/-/client-${version}.tgz"
sha256="f61ebcb6989355c08edeb0596753d8afee6429eadab7b50074dedcb220cfc622"

prepare() {
  # ============================================================
  # ohos-npm-ports: @ohos-npm-ports/prisma-client ${version}
  #
  # 构建方式：
  #   1. 下载官方 @prisma/client@${version} tarball，校验上游 manifest
  #   2. 零编译重打包：除被 patch 的 package.json 外每个文件与 pristine
  #      上游树逐字节对账（补丁只允许碰指定文件的不变量）
  #   3. npm pack 成 tarball 后做生成 + CRUD 冒烟（node + bun 双运行时）
  #
  # Prisma 7 ships the query compiler as WASM inside this tarball and talks to
  # the database through a consumer-supplied driver adapter, so unlike the 5.x
  # line it needs no OHOS Rust engine override and has no native addon.
  # ============================================================

  # ===== fetch =====
  echo "=== fetch: 官方 @prisma/client@${version} ==="
  rm -rf "${build_dir}"
  mkdir -p "${build_dir}"
  cd "${build_dir}"
  fetch_source "src.tgz"
  tar -zxf src.tgz
  rm src.tgz
  mv package src
  # record pristine hashes before any modification, for the post-assembly diff
  (cd src && find . -type f -exec sha256sum {} + | sort) >pristine.sha256
}

build() {
  echo "=== build: 校验上游 manifest ==="
  cd "${build_dir}/src"
  grep -q "\"version\": \"${version}\"" package.json
}

package() {
  echo "=== package: 组装发布目录 + pristine 对账 + npm pack ==="
  rm -rf "${build_dir}/pkg"
  mkdir "${build_dir}/pkg"
  (cd "${build_dir}/src" && tar -zcf - . | tar -zxf - -C "${build_dir}/pkg")
  rm -rf "${build_dir}/pkg/node_modules"

  cd "${build_dir}"
  # integrity: every shipped file must be byte-identical to the pristine
  # upstream tree except the patched manifest -- this also enforces that the
  # patch touches nothing else
  (cd pkg && find . -path ./package.json -prune -o -type f -exec sha256sum {} + | sort) >built.sha256
  grep -v '  \./package.json$' pristine.sha256 >pristine-no-manifest.sha256
  cmp pristine-no-manifest.sha256 built.sha256
  rm pristine.sha256 pristine-no-manifest.sha256 built.sha256
  node -e '
      const p = require("'"${build_dir}"'/pkg/package.json");
      if (p.version !== process.argv[1]) { console.error("bad manifest"); process.exit(1); }
      const { execSync } = require("child_process");
      for (const f of ["default.js", "index.js", "runtime/client.js", "runtime/client.mjs", "scripts/default-index.js"]) {
        require("fs").accessSync(require("path").join("'"${build_dir}"'/pkg", f));
        execSync("node --check " + JSON.stringify(require("path").join("'"${build_dir}"'/pkg", f)));
      }
      console.log("OK: manifest + entry files parse");
    ' "${version}"
}

check() {
  package_version=$(node -p "require('${build_dir}/pkg/package.json').version")
  (cd pkg && npm pack --ignore-scripts >/dev/null && mv ohos-npm-ports-prisma-client-${package_version}.tgz "${build_dir}")
  test -f "${build_dir}/ohos-npm-ports-prisma-client-${package_version}.tgz"

  # Prisma 7 generates a client that runs on the bundled WASM query compiler and
  # connects through a driver adapter. Use a pure-JS sql.js adapter instead of a
  # native addon so this functional smoke also runs on OpenHarmony.
  smoke_dir="${build_dir}/.smoke"
  rm -rf "$smoke_dir"
  mkdir -p "$smoke_dir/app"
  cat >"$smoke_dir/package.json" <<EOF
{
  "name": "prisma-client-port-smoke",
  "private": true,
  "dependencies": {
    "@prisma/client": "file:${build_dir}/ohos-npm-ports-prisma-client-${package_version}.tgz",
    "prisma": "${version}",
    "sql.js": "1.15.2",
    "typescript": "5.9.3"
  }
}
EOF
  cat >"$smoke_dir/app/schema.prisma" <<'EOF'
generator client {
  provider              = "prisma-client"
  output                = "./client"
  runtime               = "nodejs"
  moduleFormat          = "cjs"
  importFileExtension   = "js"
}
datasource db {
  provider = "sqlite"
}
model Widget {
  id   Int    @id @default(autoincrement())
  name String
}
EOF
  cat >"$smoke_dir/app/sqljs-adapter.cjs" <<'EOF'
const path = require("path");
const initSqlJs = require("sql.js");

// ColumnTypeEnum values from @prisma/driver-adapter-utils.
const ColumnType = { Int32: 0, Int64: 1, Double: 3, Boolean: 5, Text: 7, Bytes: 13 };

function columnType(value) {
  if (typeof value === "boolean") return ColumnType.Boolean;
  if (typeof value === "bigint") return ColumnType.Int64;
  if (typeof value === "number") return Number.isInteger(value) ? ColumnType.Int32 : ColumnType.Double;
  if (value instanceof Uint8Array) return ColumnType.Bytes;
  return ColumnType.Text;
}

class JsSqliteAdapter {
  constructor(SQL) {
    this.db = new SQL.Database();
    this.provider = "sqlite";
    this.adapterName = "ohos-prisma-client-smoke";
  }
  async queryRaw({ sql, args = [] }) {
    const stmt = this.db.prepare(sql);
    if (args.length) stmt.bind(args);
    const columnNames = stmt.getColumnNames();
    const rows = [];
    while (stmt.step()) rows.push(stmt.get());
    stmt.free();
    const columnTypes = columnNames.map((_, i) => columnType(rows.find((row) => row[i] != null)?.[i]));
    return { columnNames, columnTypes, rows };
  }
  async executeRaw({ sql, args = [] }) {
    this.db.run(sql, args);
    return this.db.getRowsModified();
  }
  async executeScript(script) {
    this.db.exec(script);
  }
  async startTransaction() {
    this.db.run("BEGIN");
    const db = this.db;
    return {
      provider: "sqlite",
      adapterName: this.adapterName,
      options: { usePhantomQuery: false },
      queryRaw: this.queryRaw.bind(this),
      executeRaw: this.executeRaw.bind(this),
      commit: async () => db.run("COMMIT"),
      rollback: async () => db.run("ROLLBACK"),
    };
  }
  async dispose() {
    this.db.close();
  }
}

async function connect() {
  const SQL = await initSqlJs({
    locateFile: (file) => path.join(path.dirname(require.resolve("sql.js/dist/sql-wasm.js")), file),
  });
  return new JsSqliteAdapter(SQL);
}

module.exports = { connect };
EOF
  cat >"$smoke_dir/app/smoke.cjs" <<'EOF'
const { connect } = require("./sqljs-adapter.cjs");
const { PrismaClient } = require("./generated/client.js");

(async () => {
  const adapter = await connect();
  await adapter.executeScript(
    'CREATE TABLE "Widget" ("id" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, "name" TEXT NOT NULL)',
  );
  const factory = { provider: "sqlite", adapterName: adapter.adapterName, connect: async () => adapter };
  const p = new PrismaClient({ adapter: factory });
  const w = await p.widget.create({ data: { name: "smoke" } });
  const f = await p.widget.findUnique({ where: { id: w.id } });
  if (!f || f.name !== "smoke") throw new Error("read-back failed");
  const n = await p.widget.count();
  if (n !== 1) throw new Error("bad count: " + n);
  await p.$disconnect();
  console.log("CRUD OK");
})().catch((e) => { console.error(e); process.exit(1); });
EOF

  smoke_abs="$(cd "$smoke_dir" && pwd)"
  cd "$smoke_dir"
  npm install --ignore-scripts --no-audit --no-fund
  cd app

  "$smoke_abs/node_modules/.bin/prisma" generate --schema schema.prisma 2>&1 | grep -q 'Generated Prisma Client' || {
    echo "generate failed" >&2
    exit 1
  }
  "$smoke_abs/node_modules/.bin/tsc" --module commonjs --target es2022 --moduleResolution node \
    --esModuleInterop --skipLibCheck --outDir generated client/client.ts
  node smoke.cjs
  # bun runtime; the ci-runner image ships no bun -- gate it and cover bun on a real device
  if command -v bun >/dev/null 2>&1; then
    bun smoke.cjs
  fi
  cd "${build_dir}"
  rm -rf "$smoke_dir" ohos-npm-ports-prisma-client-${package_version}.tgz

  echo "OK: @ohos-npm-ports/prisma-client built and smoke-tested"
}
