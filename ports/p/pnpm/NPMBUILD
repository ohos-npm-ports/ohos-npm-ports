#!/usr/bin/env bash
pkgname="pnpm"
upstream="pnpm"
version="12.16.1"
revision=1
dist_tag="latest"

packages=(
  "@ohos-npm-ports/pnpm-exe.openharmony-arm64:build/pnpm-exe.openharmony-arm64"
  "build/pnpm-wrapper-${version}"
)
slot_name="pnpm-exe.openharmony-arm64"
work_dir="$NPMBUILD_DIR"
build_dir="${work_dir}/build"
source="https://github.com/pnpm/pnpm/archive/refs/tags/v${version}.tar.gz"
sha256="baaffdb2671a414882d13379d978339a58a9e66fe099f1f00f05a47b6232322c"
resource "npm" \
  "https://registry.npmjs.org/pnpm/-/pnpm-${version}.tgz" \
  "ca362a16f2e1c3cfa81d406f3242446179a0e4aea457ba3e9e6c39e6476aba65"
resource "iana_time_zone" \
  "https://static.crates.io/crates/iana-time-zone/iana-time-zone-0.1.65.crate" \
  "e31bc9ad994ba00e440a8aa5c9ef0ec67d5cb5e5cb0cc7f8b744a35b389cc470"

prepare() {
  # ============================================================
  # ohos-npm-ports: @ohos-npm-ports/pnpm ${version}
  #
  # 构建方式：
  #   1. 下载 pnpm v12.16.1 源码 tag + pnpm@12.16.1 npm 包
  #   2. 源码打补丁：host 平台上报 openharmony、iana-time-zone 改运行时 dlopen
  #   3. cargo 构建 pnpm-cli，strip
  #   4. 槽位包 @ohos-npm-ports/pnpm-exe.openharmony-arm64 携带二进制
  #   5. 主包 = 上游 npm wrapper 重打包 + native-binary.mjs
  #      增加 openharmony 平台分支
  # ============================================================

  echo "=== deps: toolchain ==="
  mkdir -p /data/storage/el2/base/cache /data/storage/el2/base/file
  brew install -y cmake pkgconf
  cargo --version

  echo "=== fetch: sources ==="
  rm -rf "${build_dir}"
  mkdir -p "${build_dir}"
  fetch_source "${build_dir}/pnpm-src.tar.gz"
  fetch_resource "npm" "${build_dir}/pnpm-npm.tgz"
  fetch_resource "iana_time_zone" "${build_dir}/iana-time-zone.crate"
  tar -zxf "${build_dir}/pnpm-src.tar.gz" -C "${build_dir}"
  mkdir -p "${build_dir}/wrapper"
  tar -zxf "${build_dir}/pnpm-npm.tgz" -C "${build_dir}/wrapper"
  # pristine-diff 基线：补丁只允许碰 package.json 和 native-binary.mjs
  node -e '
        const fs = require("fs"), crypto = require("crypto"), path = require("path");
        const walk = (dir) => fs.readdirSync(dir, { withFileTypes: true }).flatMap((e) =>
            e.isDirectory() ? walk(path.join(dir, e.name)) : [path.join(dir, e.name)]);
        const hashes = {};
        for (const f of walk(process.argv[1]).sort()) {
            hashes[path.relative(process.argv[1], f)] =
                crypto.createHash("sha256").update(fs.readFileSync(f)).digest("hex");
        }
        fs.writeFileSync(process.argv[2], JSON.stringify(hashes, null, 1));
    ' "${build_dir}/wrapper/package" "${build_dir}/wrapper-pristine.json"
}

build() {
  echo "=== build: patch + cargo ==="
  source_dir="${build_dir}/pnpm-${version}"

  rm -f "${source_dir}/.cargo/config.toml"

  for p in "${work_dir}"/patches/0001-host-platform-openharmony.patch \
    "${work_dir}"/patches/0002-iana-time-zone-vendor.patch \
    "${work_dir}"/patches/0003-cargo-lock-iana-time-zone.patch \
    "${work_dir}"/patches/0007-use-ohos-tempdir.patch; do
    (cd "${source_dir}" && patch -p1 <"$p")
  done
  # iana-time-zone 运行时 dlopen 改写：vendor 进源码树再打
  mkdir -p "${source_dir}/vendor"
  tar -zxf "${build_dir}/iana-time-zone.crate" -C "${source_dir}/vendor"
  mv "${source_dir}/vendor/iana-time-zone-0.1.65" "${source_dir}/vendor/iana-time-zone"
  (cd "${source_dir}" && patch -p1 <"${work_dir}/patches/0004-iana-time-zone-dlopen.patch")
  # toybox patch 错 header 会静默 no-op，退出码不可信，grep marker 确认
  grep -q 'openharmony' "${source_dir}/pnpm/crates/detect-libc/src/lib.rs"
  grep -q 'iana-time-zone = { path' "${source_dir}/Cargo.toml"
  ! grep -q "$resource_iana_time_zone_sha256" "${source_dir}/Cargo.lock"
  grep -q 'dlopen' "${source_dir}/vendor/iana-time-zone/src/tz_ohos.rs"
  # 0007: store 操作锁的根目录。pnpm 的 secure_user_lock_dir 在没有可用的
  # XDG_RUNTIME_DIR 时会退回 /tmp（刻意不读 TMPDIR，让不同 TMPDIR 的进程
  # 仍共享同一把锁），而 OHOS 的 /tmp 只读，于是 install 报
  # ERR_PNPM_STORE_DIR_OPEN_OPERATION_LOCK。
  grep -q 'OHOS_TEMP_DIR: &str = "/data/storage/el2/base/cache"' \
    "${source_dir}/pnpm/crates/fs/src/secure_temp_lock.rs"

  # aws-lc-sys 构建 CPU Jitter RNG 需要 -O0，superenv 会把它优化掉
  export AWS_LC_SYS_NO_JITTER_ENTROPY=1
  (cd "${source_dir}" && cargo install --locked --path pnpm/crates/cli --root "${build_dir}/cargo-root")

  bin_path="${build_dir}/cargo-root/bin/pnpm"
  test -f "${bin_path}"
  "${bin_path}" --version

  llvm-strip --strip-all "${bin_path}" -o "${build_dir}/pnpm-bin"
  chmod +x "${build_dir}/pnpm-bin"
}

package() {
  echo "=== package: slot + main ==="
  slot_dir="${build_dir}/${slot_name}"
  rm -rf "${slot_dir}"
  mkdir -p "${slot_dir}"
  cp "${build_dir}/pnpm-bin" "${slot_dir}/pnpm"
  chmod +x "${slot_dir}/pnpm"
  cat >"${slot_dir}/package.json" <<EOF
{
  "version": "${version}",
  "license": "MIT",
  "os": ["openharmony"],
  "cpu": ["arm64"],
  "publishConfig": {
    "executableFiles": ["./pnpm"]
  }
}
EOF

  main_dir="${build_dir}/pnpm-wrapper-${version}"
  mv "${build_dir}/wrapper/package" "${main_dir}"
  (cd "${main_dir}" && patch -p1 <"${work_dir}/patches/0005-update-package-json.patch")
  (cd "${main_dir}" && patch -p1 <"${work_dir}/patches/0006-native-binary-openharmony.patch")
  grep -qF '@ohos-npm-ports/pnpm-exe.openharmony-arm64/pnpm' "${main_dir}/native-binary.mjs"

  # pristine-diff 不变量：组装产物与上游解包逐字节一致，
  # 唯一允许改写的文件是两个 patch 的载体
  node -e '
        const fs = require("fs"), crypto = require("crypto"), path = require("path");
        const walk = (dir) => fs.readdirSync(dir, { withFileTypes: true }).flatMap((e) =>
            e.isDirectory() ? walk(path.join(dir, e.name)) : [path.join(dir, e.name)]);
        const current = {};
        for (const f of walk(process.argv[1]).sort()) {
            current[path.relative(process.argv[1], f)] =
                crypto.createHash("sha256").update(fs.readFileSync(f)).digest("hex");
        }
        const pristine = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
        const allowed = new Set(["package.json", "native-binary.mjs"]);
        for (const k of new Set([...Object.keys(pristine), ...Object.keys(current)])) {
            if (pristine[k] !== current[k] && !allowed.has(k)) {
                throw new Error("wrapper drift beyond patched files: " + k);
            }
        }
    ' "${main_dir}" "${build_dir}/wrapper-pristine.json"
  "${slot_dir}/pnpm" --version

  # loader 平台分支：openharmony 命中槽位，其他平台仍走上游包
  (cd "${main_dir}" && node --input-type=module -e '
        Object.defineProperty(process, "platform", { value: "openharmony" });
        const m = await import("./native-binary.mjs");
        const c = m.getBinCandidates();
        if (c.length !== 1 || c[0] !== "@ohos-npm-ports/pnpm-exe.openharmony-arm64/pnpm") throw new Error("openharmony: " + JSON.stringify(c));
    ')
  for plat in linux darwin win32; do
    (cd "${main_dir}" && node --input-type=module -e '
            Object.defineProperty(process, "platform", { value: "'"$plat"'" });
            const m = await import("./native-binary.mjs");
            const c = m.getBinCandidates();
            if (c.length === 0 || !c.every((s) => s.startsWith("@pnpm/exe."))) throw new Error("'"$plat"': " + JSON.stringify(c));
        ')
  done
  test -d "${work_dir}/build/${slot_name}"
  test -d "${work_dir}/build/pnpm-wrapper-${version}"
}
