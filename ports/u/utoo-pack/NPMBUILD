#!/usr/bin/env bash
pkgname="utoo-pack"
upstream="@utoo/pack"
version="1.5.31"
revision=3
# npm 包与 utoo/next.js 固定 commit 需人工配套升级。
bump=false
source="https://registry.npmjs.org/@utoo/pack/-/pack-${version}.tgz"
sha256="d7f1a2442bc65259f791dbb625c4a4a63a20bba39e2969ea9fa05a6b95559dcb"
resource "utoo" \
  "https://codeload.github.com/utooland/utoo/tar.gz/0e838fbfa1105d68dfdd2c1fc4f79fb1c1feebbd" \
  "28f208e1280fc01aa05d8ec5663b7ced5a6907da44c7361cb5be6a818a7d9c64"
resource "next" \
  "https://codeload.github.com/utooland/next.js/tar.gz/815238d6a4a18958c43a6875a86026d20a424dac" \
  "30c63a6c41d7a945f2121e8300c739e992c28dc246cfbde4d2fa913ba395d336"
dist_tag="latest"

packages=(
  "build/utoo-pack-${version}"
)

root_dir="$NPMBUILD_DIR"
build_dir="$NPMBUILD_WORK_DIR"
source_dir="$build_dir/source"
package_dir="$build_dir/utoo-pack-${version}"

prepare() {
  brew install -y cmake pkgconf
  [ "$(rustc -vV | sed -n 's/^host: //p')" = aarch64-unknown-linux-ohos ]

  extract_resource "utoo" "$source_dir"
  extract_resource "next" "$source_dir/next.js" -- \
    --exclude='*/test' --exclude='*/examples' --exclude='*/.claude'
  extract_source "$build_dir/upstream"
  mkdir -p "$package_dir"
  cp -R "$build_dir/upstream/." "$package_dir/"
}

build() {
  cd "$source_dir"
  export RUSTC_BOOTSTRAP=1
  export CARGO_TARGET_DIR="$build_dir/target"
  export CARGO_PROFILE_RELEASE_LTO=false
  export VERGEN_GIT_SHA=0e838fbfa1105d68dfdd2c1fc4f79fb1c1feebbd
  export VERGEN_GIT_DIRTY=false
  export CC=cc CXX=c++
  cargo build --locked --release -p pack-napi --features plugin -j "${CARGO_BUILD_JOBS:-2}"
}

package() {
  cd "$package_dir"
  manifest_remove_script package.json prepublishOnly
  patch -p1 <"$root_dir/patches/0001-package-json.patch"
  patch -p1 <"$root_dir/patches/0002-share-openharmony-binding.patch"
  grep -q '../cjs/pack.openharmony-arm64.node' esm/binding.js
  cp "$source_dir/LICENSE" LICENSE
  cp "$source_dir/next.js/license.md" cjs/LICENSE-turbopack
  cp "$build_dir/target/release/libpack_napi.so" cjs/pack.openharmony-arm64.node
  cmp "$source_dir/LICENSE" "$package_dir/LICENSE"
  cmp "$source_dir/next.js/license.md" "$package_dir/cjs/LICENSE-turbopack"
  grep -q "process.platform === 'openharmony'" "$package_dir/cjs/binding.js"
  test -s "$package_dir/cjs/pack.openharmony-arm64.node"
  node "$root_dir/verify.cjs" "$package_dir" "$build_dir/upstream"
}
