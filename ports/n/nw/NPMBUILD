#!/usr/bin/env bash
pkgname="nw"
upstream="nw"
version="0.119.2"
revision=3
source="https://registry.npmjs.org/nw/-/nw-${version}.tgz"
sha256="702f94647266ac353e487c0420c01436e3eb23640e425e42ef00417d6de21495"
dist_tag="latest"

packages=(
  "build/nw-${version}"
)

work_dir="$NPMBUILD_DIR"
build_dir="$work_dir/build"
output_dir="$build_dir/nw-${version}"

prepare() {
  mkdir -p "$build_dir"
  fetch_source "$build_dir/nw.tgz"
  rm -rf "$output_dir"
  mkdir -p "$output_dir"
  tar -xzf "$build_dir/nw.tgz" -C "$output_dir" --strip-components=1
  node - "$output_dir" "$build_dir/original.json" <<'JS'
const fs = require('node:fs'), path = require('node:path'), crypto = require('node:crypto');
const root = process.argv[2];
const hashes = {};
function visit(dir) { for (const item of fs.readdirSync(dir, { withFileTypes: true })) {
  const file = path.join(dir, item.name);
  if (item.isDirectory()) visit(file);
  else hashes[path.relative(root, file).split(path.sep).join('/')] = crypto.createHash('sha256').update(fs.readFileSync(file)).digest('hex');
} }
visit(root); fs.writeFileSync(process.argv[3], JSON.stringify(hashes));
JS
}

build() {
  cd "$output_dir"
  patch -p1 <"$work_dir/patchs/0001-local-browser-backend.patch"
  grep -q 'openharmony' src/postinstall.js
  grep -q 'ohos.run' src/index.js
}

package() {
  mkdir -p "$output_dir/src/ohos"
  cp "$work_dir"/ohos/*.cjs "$output_dir/src/ohos/"
  node - "$output_dir" "$build_dir/original.json" <<'JS'
const fs = require('node:fs'), path = require('node:path'), crypto = require('node:crypto'), assert = require('node:assert/strict');
const root = process.argv[2], hashes = JSON.parse(fs.readFileSync(process.argv[3]));
const changed = new Set(['package.json', 'src/index.js', 'src/cli.js', 'src/postinstall.js']);
for (const [file, hash] of Object.entries(hashes)) {
  if (!changed.has(file)) assert.equal(crypto.createHash('sha256').update(fs.readFileSync(path.join(root, file))).digest('hex'), hash, file);
}
const pkg = JSON.parse(fs.readFileSync(path.join(root, 'package.json')));
assert.equal(pkg.name, '@ohos-npm-ports/nw');
assert.equal(pkg.version, `${process.env.NPMBUILD_VERSION}`);
assert.equal(pkg.dependencies['@ohos-npm-ports/playwright-core'], '1.62.1-5');
for (const file of ['runtime.cjs', 'server.cjs', 'browser.cjs']) assert.ok(fs.existsSync(path.join(root, 'src/ohos', file)));
JS
}

check() {
  cd "$output_dir"
  npm install --ignore-scripts --omit=dev --no-audit --no-fund
  node --check src/index.js
  node --check src/cli.js
  node --check src/postinstall.js
  if [ "$(node -p process.platform)" = openharmony ]; then node src/postinstall.js; fi
  node "$work_dir/tests/dispatch.cjs" "$output_dir/src/index.js"
  for test_file in server browser endpoint; do
    NW_TEST_IMPL="$output_dir/src/ohos" node "$work_dir/tests/$test_file.cjs"
  done
  node -e 'import("./src/index.js").then(api => { for (const name of ["get", "run", "findpath"]) if (typeof api[name] !== "function") throw Error(name); });'
  node src/cli.js --help
  npm pack --ignore-scripts --silent
  rm -rf "$build_dir/consumer"
  mkdir -p "$build_dir/consumer"
  cd "$build_dir/consumer"
  npm init -y >/dev/null
  npm install --ignore-scripts --no-audit --no-fund "$output_dir/ohos-npm-ports-nw-${version}.tgz"
  node -e 'import("@ohos-npm-ports/nw").then(api => { if (typeof api.run !== "function") throw Error("consumer entry"); });'
  for test_file in server browser endpoint; do
    NW_TEST_IMPL="$build_dir/consumer/node_modules/@ohos-npm-ports/nw/src/ohos" node "$work_dir/tests/$test_file.cjs"
  done
}
