#!/usr/bin/env bash
pkgname="next"
upstream="next"
version="16.4.6"
revision=2
source="https://registry.npmjs.org/${pkgname}/-/${pkgname}-${version}.tgz"
sha256="954cc114e2e4f57464f6d2f6640ec9b7a8e493ad4373c692b2d37d135da2806a"
resource "upstream" \
  "https://codeload.github.com/vercel/next.js/tar.gz/refs/tags/v${version}" \
  "248d0ea591b75872ae83215f17c244fa107172cd4a3870a6bcababa20d4ceb26"
dist_tag="latest"

packages=(
  "@ohos-npm-ports/next-swc-openharmony-arm64:build/next-swc-openharmony-arm64"
  "build/next-${version}"
)
root_dir="$NPMBUILD_WORK_DIR"
port_dir="$NPMBUILD_DIR"

prepare() {
  # ===== deps =====
  command -v curl >/dev/null
  command -v cargo >/dev/null

  rm -rf "$root_dir/next-swc-openharmony-arm64"
  mkdir -p "$root_dir/next-swc-openharmony-arm64"

  extract_resource "upstream" "$root_dir/src"
  rm -f "$root_dir/src/rust-toolchain.toml"

  extract_source "$root_dir/next-$version"
}

build() {
  host_triple=$(rustc -vV | sed -n 's/^host: //p')
  [ "$host_triple" = "aarch64-unknown-linux-ohos" ]

  cd "$root_dir/src"
  git init
  upstream_commit=$(git ls-remote https://github.com/vercel/next.js.git "refs/tags/v${version}" | cut -c1-7)
  [ "${#upstream_commit}" -eq 7 ]
  export VERGEN_GIT_SHA="$upstream_commit"
  export VERGEN_GIT_DIRTY=false
  source_date_epoch="$(stat -c %Y Cargo.toml)"
  build_date="$(date -u -d "@${source_date_epoch}" '+%b %e %Y')"
  build_time="$(date -u -d "@${source_date_epoch}" '+%H:%M:%S')"
  cflags_reproducible='-Wno-builtin-macro-redefined'
  cflags_reproducible+=" -D__DATE__='\"${build_date}\"'"
  cflags_reproducible+=" -D__TIME__='\"${build_time}\"'"
  export CC_SHELL_ESCAPED_FLAGS=1
  export CFLAGS="${CFLAGS:-} ${cflags_reproducible}"
  GIT_AUTHOR_DATE="@${source_date_epoch}" GIT_COMMITTER_DATE="@${source_date_epoch}" \
    git -c user.name=npm-ports -c user.email=npm-ports@localhost commit --allow-empty -m "Next.js $version source"
  patch -p1 <"$port_dir/patches/0003-turbo-tasks-fs-ohos.patch"
  grep -q "into_os_string" turbopack/crates/turbo-tasks-fs/src/disk.rs
  patch -p1 <"$port_dir/patches/0004-openharmony-project-path.patch"
  grep -q "into_os_string" crates/next-napi-bindings/src/next_api/project.rs
  # The upstream workspace enables nightly-only optimization flags. The build
  # image uses stable rustc, so bootstrap those flags without another toolchain.
  export RUSTC_BOOTSTRAP=1
  cargo build -p next-napi-bindings --release \
    --features image-extended,tracing/release_max_level_trace
  test -f target/release/libnext_napi_bindings.so
  cp target/release/libnext_napi_bindings.so \
    "$root_dir/next-swc-openharmony-arm64/next-swc.openharmony-arm64.node"
  cd "$root_dir"
}

package() {
  cd "$root_dir"
  llvm-strip --strip-all \
    next-swc-openharmony-arm64/next-swc.openharmony-arm64.node
  chmod +x next-swc-openharmony-arm64/next-swc.openharmony-arm64.node

  cd "$root_dir/next-$version"
  patch -p1 <"$port_dir/patches/0001-openharmony-loader.patch"
  patch -p1 <"$port_dir/patches/0002-package-json.patch"
  cd "$root_dir"

  cat >next-swc-openharmony-arm64/package.json <<EOF
{
  "version": "${version}",
  "description": "OpenHarmony arm64 native SWC binding for Next.js",
  "os": ["openharmony"],
  "cpu": ["arm64"],
  "main": "next-swc.openharmony-arm64.node",
  "files": ["next-swc.openharmony-arm64.node"],
  "license": "MIT",
  "engines": { "node": ">= 20" }
}
EOF
  grep -q "openharmony-arm64" next-${version}/dist/build/swc/index.js
  grep -q "@ohos-npm-ports/next-swc-openharmony-arm64" next-${version}/dist/build/swc/index.js
}
