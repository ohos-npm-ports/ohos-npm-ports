#!/usr/bin/env bash
pkgname="domparser-rs"
upstream="domparser-rs"
version="0.0.7"
revision=3
# npm 包与固定源码 commit 需人工配套升级。
bump=false
source="https://registry.npmjs.org/domparser-rs/-/domparser-rs-${version}.tgz"
sha256="fef9487622af8ccc1e4fdc60e1795fde5ad84766d3dd253e601d648a8fa5dc5e"
resource "upstream" \
  "https://codeload.github.com/utooland/domparser-rs/tar.gz/79e32cd0ae4902a907a91b9c079c3de1f152db95" \
  "cea5f6328b4db383de21aed329d6500eba5fa5537725242903705410584e773b"
dist_tag="latest"

packages=(
  "build/domparser-rs-${version}"
)

root_dir="$NPMBUILD_DIR"
build_dir="$NPMBUILD_WORK_DIR"
source_dir="$build_dir/source"
package_dir="$build_dir/domparser-rs-${version}"

prepare() {
  command -v cargo >/dev/null
  [ "$(rustc -vV | sed -n 's/^host: //p')" = aarch64-unknown-linux-ohos ]

  extract_resource "upstream" "$source_dir"
  extract_source "$build_dir/upstream"
  mkdir -p "$package_dir"
  cp -R "$build_dir/upstream/." "$package_dir/"
}

build() {
  cd "$source_dir"
  export CARGO_TARGET_DIR="$build_dir/target"
  cargo build --locked --release -p domparser_napi -j "${CARGO_BUILD_JOBS:-2}"
}

package() {
  cd "$package_dir"
  patch -p1 <"$root_dir/patches/0001-package-json.patch"
  cp "$build_dir/target/release/libdomparser_napi.so" domparser.openharmony-arm64.node
  grep -q "process.platform === 'openharmony'" "$package_dir/index.js"
  test -s "$package_dir/domparser.openharmony-arm64.node"
  node "$root_dir/verify.cjs" "$package_dir" "$build_dir/upstream"
}
