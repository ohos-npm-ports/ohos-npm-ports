+import { execFileAsync, getFreePort, httpGetJson, isOpenHarmony, resolveCommandPath, waitForEndpoint } from './utils';
+
+import type { Browser } from '../server/browser';
+import type { Chromium } from '../server/chromium/chromium';
+import type { CRBrowser } from '../server/chromium/crBrowser';
+import type { Progress } from '../server/progress';
+import type * as types from '../server/types';
+
+export interface LaunchConfig {
+  bundleName: string;
+  abilityName: string;
+  /** 'tcp' browsers listen on a TCP port; 'socket' browsers expose a Unix socket. */
+  kind: 'tcp' | 'socket';
+  /** Fixed debug port for browsers that cannot receive one through arguments. */
+  port?: number;
+  /** Whether the browser accepts extra arguments through the `cmdArgs` parameter. */
+  supportsCmdArgs?: boolean;
+  /** URL opened at launch (aa start -U). */
+  launchUrl?: string;
+  /** Extra command-line flags appended to the default stability flags. */
+  extraArgs?: string[];
+}
+
+// Stability flags for browsers launched through cmdArgs; test runs should
+// not be disturbed by first-run screens, sync or component updates.
+const DEFAULT_CMDARGS_FLAGS = [
+  '--no-first-run',
+  '--disable-extensions',
+  '--disable-sync',
+  '--disable-default-apps',
+  '--disable-background-networking',
+  '--disable-component-update',
+  '--no-default-browser-check',
+];
+
+const KNOWN_BROWSERS: Record<string, LaunchConfig> = {
+  'huaweiBrowser': {
+    bundleName: 'com.huawei.hmos.browser',
+    abilityName: 'MainAbility',
+    kind: 'socket',
+  },
+  'chrome': {
+    bundleName: 'com.haitai.htbrowser',
+    abilityName: 'EntryAbility',
+    kind: 'tcp',
+    supportsCmdArgs: true,
+  },
+  'chrome-beta': {
+    bundleName: 'com.huawei.ohos_chromium',
+    abilityName: 'BrowserAbility',
+    kind: 'tcp',
+    port: 9222,
+  },
+};
+
+export const ARK_WEB_BUNDLE_NAME = 'com.huawei.hmos.browser';
+
+export const resolveLaunchConfig = (options: types.LaunchOptions): LaunchConfig => {
+  const envBrowser = process.env.HARMONY_BROWSER;
+  const ability = options.harmonyAbility ?? process.env.HARMONY_ABILITY;
+  const launchUrl = options.harmonyLaunchUrl ?? process.env.HARMONY_LAUNCH_URL;
+  const custom = options.harmonyBundleName || (envBrowser && !KNOWN_BROWSERS[envBrowser] ? envBrowser : undefined);
+  const channel = envBrowser && KNOWN_BROWSERS[envBrowser] ? envBrowser : (options.channel ?? 'chrome');
+  const known = KNOWN_BROWSERS[channel];
+  const config: LaunchConfig = known ? { ...known } : { bundleName: channel, abilityName: 'MainAbility', kind: 'tcp', supportsCmdArgs: true };
+  if (custom)
+    config.bundleName = custom;
+  if (ability)
+    config.abilityName = ability;
+  if (launchUrl)
+    config.launchUrl = launchUrl;
+  const userArgs = [...(options.harmonyArgs ?? []), ...(options.args ?? [])];
+  const userPort = userArgs.flatMap(arg => {
+    const m = arg.match(/^--remote-debugging-port=(\d+)$/);
+    return m ? [Number(m[1])] : [];
+  })[0];
+  if (userPort)
+    config.port = userPort;
+  if (userArgs.length)
+    config.extraArgs = userArgs.filter(arg => !arg.startsWith('--remote-debugging-port='));
+  const port = options.harmonyDebugPort ?? (process.env.HARMONY_DEBUG_PORT ? Number(process.env.HARMONY_DEBUG_PORT) : undefined);
+  if (port && !config.port)
+    config.port = port;
+  return config;
+};
+
+const startBrowserViaAa = async (config: LaunchConfig): Promise<string> => {
+  if (!isOpenHarmony())
+    throw new Error('Local aa launch requires an OpenHarmony host; use connectOverCDP for an existing TCP endpoint.');
+  if (config.kind !== 'tcp')
+    throw new Error('This browser does not expose TCP CDP; use an installed TCP CDP browser such as Haitai.');
+  const aa = resolveCommandPath('aa');
+  if (!aa)
+    throw new Error('Local aa command not found; install or expose aa on PATH.');
+  const port = config.port ?? (config.supportsCmdArgs ? await getFreePort() : 9222);
+  const args = ['start', '-b', config.bundleName, '-a', config.abilityName];
+  if (config.supportsCmdArgs)
+    args.push('--ps', 'cmdArgs', [...DEFAULT_CMDARGS_FLAGS, ...(config.extraArgs || []), `--remote-debugging-port=${port}`].join(' '));
+  if (config.launchUrl)
+    args.push('-U', config.launchUrl);
+  const result = await execFileAsync(aa, args, 5000).catch(error => {
+    if (error.code !== 'ENOEXEC')
+      throw error;
+    // Some system aa wrappers have a comment before their shebang.
+    return execFileAsync('sh', [aa, ...args], 5000);
+  });
+  if (!result.stdout.includes('start ability successfully'))
+    throw new Error(`aa start failed: ${result.stdout || result.stderr}`);
+  const endpointURL = `http://127.0.0.1:${port}`;
+  try {
+    await waitForEndpoint(`${endpointURL}/json/version`, 5000);
+  } catch (error) {
+    throw new Error(`Local CDP is unavailable at ${endpointURL}. Save and close an existing browser manually before retrying: ${error.message}`);
+  }
+  const version = await httpGetJson(`${endpointURL}/json/version`);
+  if (!version.Browser || !version.webSocketDebuggerUrl)
+    throw new Error(`Endpoint ${endpointURL} is not a CDP browser`);
+  return endpointURL;
+};
+
+const patchBrowserClose = (browser: CRBrowser): void => {
+  const browserProcess = browser.options.browserProcess;
+  let closed = false;
+  const originalClose = browserProcess.close.bind(browserProcess);
+  const originalKill = browserProcess.kill.bind(browserProcess);
+  const close = async (disconnect: () => Promise<void>) => {
+    if (closed)
+      return;
+    closed = true;
+    try {
+      await browser._session.send('Browser.close').catch(() => {});
+      await disconnect();
+    } finally {
+      browserProcess.onclose?.(0, null);
+    }
+  };
+  browserProcess.close = () => close(originalClose);
+  browserProcess.kill = () => close(originalKill);
+};
+
+export const launchViaAa = async (chromium: Chromium, progress: Progress, options: types.LaunchOptions): Promise<Browser> => {
+  const config = resolveLaunchConfig(options);
+  const endpointURL = await progress.race(startBrowserViaAa(config));
+  const browser = await chromium._connectOverCDPInternal(progress, endpointURL, {
+    ...options,
+    __ohosDeviceBrowser: true,
+    __ohosArkWeb: false,
+    __ohosNoDefaultContext: true,
+  });
+  browser._isBrowserCollocatedWithServer = false;
+  patchBrowserClose(browser);
+  return browser;
+};
+
+export const ohosInitScript = `
+(() => {
+  // The device browsers expose navigator.webdriver through a getter-only
+  // property, so plain assignment is ignored.
+  try {
+    Object.defineProperty(navigator, 'webdriver', { value: true, configurable: true });
+  } catch (e) {
+  }
+  try {
+    if (typeof Touch !== 'undefined' && Touch.prototype) {
+      for (const key of ['clientX', 'clientY', 'pageX', 'pageY', 'screenX', 'screenY']) {
+        const descriptor = Object.getOwnPropertyDescriptor(Touch.prototype, key);
+        if (descriptor && descriptor.get) {
+          Object.defineProperty(Touch.prototype, key, {
+            get() {
+              return Math.round(descriptor.get.call(this));
+            },
+            configurable: true,
+          });
+        }
+      }
+    }
+  } catch (e) {
+  }
+  // The device browsers fire contextmenu on mouse release, while desktop
+  // chromium fires it on press. Synthesize it on press and suppress the
+  // native one so the event fires exactly once.
+  try {
+    document.addEventListener('contextmenu', event => {
+      if (event.isTrusted) {
+        event.preventDefault();
+        event.stopImmediatePropagation();
+      }
+    }, { capture: true });
+    document.addEventListener('mousedown', event => {
+      if (event.button !== 2 || event.defaultPrevented) {
+        return;
+      }
+      setTimeout(() => {
+        event.target.dispatchEvent(new MouseEvent('contextmenu', {
+          bubbles: true,
+          cancelable: true,
+          button: 2,
+          view: window,
+          clientX: event.clientX,
+          clientY: event.clientY,
+        }));
+      }, 0);
+    }, true);
+  } catch (e) {
+  }
+})();
+`;
