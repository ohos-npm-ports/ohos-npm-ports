#!/usr/bin/env bash
pkgname="ast-grep-napi"
upstream="@ast-grep/napi"
version="0.51.1"
revision=1
dist_tag="latest"

packages=(
  "build/ast-grep-napi-${version}"
)
source="https://github.com/ast-grep/ast-grep/archive/refs/tags/${version}.tar.gz"
sha256="a9cb3f5cac1c0d22df189117df8d78fa3d7e9fdcd83fb5b6ab1f0b66c8835a55"
resource "npm" \
  "https://registry.npmjs.org/@ast-grep/napi/-/napi-${version}.tgz" \
  "465c3315952a85ee70af1a47035d34b692cfac59342e9c33e7ad92c5a9cafd2e"
build() {
  extract_source "$NPMBUILD_WORK_DIR/ast-grep-${version}"
  cd "$NPMBUILD_WORK_DIR/ast-grep-${version}"

  if ! curl -fsIL --max-time 8 -o /dev/null "https://index.crates.io/config.json" 2>/dev/null; then
    export CARGO_REGISTRIES_CRATES_IO_INDEX="sparse+https://rsproxy.cn/index/"
  fi

  cargo build -p ast-grep-napi --release

  node_src=$(find target/release -maxdepth 1 -name 'libast_grep_napi.so' | head -1)
  [ -n "$node_src" ] || {
    echo "no napi cdylib in target/release" >&2
    exit 1
  }
  cp "$node_src" "$NPMBUILD_WORK_DIR/ast-grep-napi.node"

  extract_resource "npm" "$NPMBUILD_WORK_DIR/ast-grep-napi-${version}"
  cd "$NPMBUILD_WORK_DIR/ast-grep-napi-${version}"
  manifest_add_files package.json 'ast-grep-napi.openharmony-arm64.node'
  manifest_remove_script package.json prepublishOnly
  grep -q "\"version\": \"${version}\"" package.json
  grep -q '"ast-grep-napi.openharmony-arm64.node"' package.json
  grep -q '"@ast-grep/napi-linux-arm64-gnu": "'"${version}"'"' package.json

  cp "../ast-grep-napi.node" "ast-grep-napi.openharmony-arm64.node"
  chmod +x "ast-grep-napi.openharmony-arm64.node"

  grep -q "process.platform === 'openharmony'" index.js
  grep -q "./ast-grep-napi.openharmony-arm64.node" index.js

}
