#!/usr/bin/env bash
pkgname="bufferutil"
upstream="bufferutil"
version="4.2.0"
revision=1
dist_tag="latest"

packages=(
  "build/bufferutil-${version}"
)
source="https://github.com/websockets/bufferutil/archive/refs/tags/v${version}.tar.gz"
sha256="0e6c349def04bfea40fc09aec833ca55da616d8bc29f71f107c00955323e5a50"
resource "npm" \
  "https://registry.npmjs.org/bufferutil/-/bufferutil-${version}.tgz" \
  "5188503861441cf6431dc8343e63c677605c19cd3b1cf8b19c4fb381ce4a9094"

build() {
  # 准备源码
  extract_source "$NPMBUILD_WORK_DIR/bufferutil-${version}"
  cd "$NPMBUILD_WORK_DIR/bufferutil-${version}"
  patch -p1 <"$NPMBUILD_DIR/patches/0001-update-package-json.patch"

  # 构建 addon
  npm install
  npm run prebuild

  # 把其他平台的预构建产物复制到包里面一起发布
  extract_resource "npm" "$NPMBUILD_WORK_DIR/npm"
  cp -r "$NPMBUILD_WORK_DIR/npm/prebuilds/"* "$NPMBUILD_WORK_DIR/bufferutil-${version}/prebuilds/"
  cd "$NPMBUILD_WORK_DIR/bufferutil-${version}/prebuilds"
  mv linux-x64/bufferutil.node linux-x64/@ohos-npm-ports+bufferutil.node
  mv win32-ia32/bufferutil.node win32-ia32/@ohos-npm-ports+bufferutil.node
  mv win32-x64/bufferutil.node win32-x64/@ohos-npm-ports+bufferutil.node
  for platform in darwin-x64 darwin-arm64 darwin-x64+arm64; do
    if [ -d "$platform" ]; then
      mv "$platform/bufferutil.node" "$platform/@ohos-npm-ports+bufferutil.node"
    fi
  done
}
